APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Keep this secret in the backend only. Create it in Google AI Studio.
STT_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-transcribe-live
# Empty means automatic language detection. Example: en-IN,hi-IN
GEMINI_LANGUAGE_CODES=
GEMINI_TRANSCRIPTION_MODE=VERBATIM
# Rotate before the model's 10-minute provider-session limit. These defaults
# preserve one Mentara session while replacing the underlying Gemini socket.
GEMINI_ROTATION_ENABLED=true
GEMINI_ROTATION_INTERVAL_SECONDS=540
GEMINI_ROTATION_FINAL_WAIT_SECONDS=10
GEMINI_ROTATION_BUFFER_CHUNKS=20
GEMINI_ROTATION_MAX_ATTEMPTS=3
GEMINI_ROTATION_RETRY_BASE_SECONDS=0.25

# Milestone 3 conversation analysis. Disable for a clean M2-only rollback.
CONVERSATION_ANALYSIS_ENABLED=true
CONVERSATION_TURN_MERGE_WINDOW_MS=250

# Milestone 5 bounded logical-session memory. Disable this one boundary to use
# the verified M4 recent-turn context assembler without retaining M5 memory.
MEMORY_CONTEXT_ENABLED=true
MEMORY_MAX_RETAINED_TURNS=256
MEMORY_MAX_RETAINED_TEXT_CHARS=160000
MEMORY_MAX_TURN_CHARS=4000
MEMORY_CONTEXT_RECENT_TURNS=4
MEMORY_CONTEXT_RELEVANT_TURNS=4

# Milestone 5.5 advisory prediction side-car. It uses an independent stateless
# provider call and never creates transcript, memory, fact or answer truth.
# Disable this one boundary to preserve the exact verified M5 path.
PREDICTION_ENABLED=true
PREDICTION_PROVIDER=gemini
GEMINI_PREDICTION_MODEL=gemini-3.5-flash-lite
GEMINI_PREDICTION_THINKING_LEVEL=minimal
PREDICTION_MIN_ACTIVE_CHARS=12
PREDICTION_MIN_LEXICAL_TOKENS=3
PREDICTION_LONG_PARTIAL_CHARS=48
PREDICTION_COALESCE_MS=350
PREDICTION_MIN_CALL_INTERVAL_MS=1200
PREDICTION_CANCELLED_ATTEMPT_COOLDOWN_MS=4000
# Preserve one running/ready attempt only across a short, neutral append-only
# preface. Set to 0 for strict cancellation on every text change.
PREDICTION_MAX_COMPATIBLE_EXTENSION_CHARS=96
PREDICTION_MAX_ATTEMPTS_PER_TURN=2
PREDICTION_MAX_CALLS_PER_SESSION=64
PREDICTION_PROVIDER_TIMEOUT_SECONDS=5
PREDICTION_MAX_CANDIDATES=3
PREDICTION_MAX_OUTPUT_TOKENS=512
PREDICTION_CONTEXT_RECENT_TURNS=2
PREDICTION_CONTEXT_RELEVANT_TURNS=2
PREDICTION_CONTEXT_MAX_TOTAL_CHARS=3200
PREDICTION_CONTEXT_MAX_ACTIVE_CHARS=1200
PREDICTION_CONTEXT_MAX_MEMORY_TURN_CHARS=800

# Milestone 4 provider-neutral answer generation. Disable this single boundary
# to preserve M1-M3 transcription, turn finalization and question detection.
ANSWER_GENERATION_ENABLED=true
ANSWER_PROVIDER=gemini
GEMINI_ANSWER_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_THINKING_LEVEL=minimal
ANSWER_MAX_OUTPUT_TOKENS=512
ANSWER_GENERATION_TIMEOUT_SECONDS=20
# Context is deterministic and bounded; it is not provider-side memory.
ANSWER_CONTEXT_RECENT_TURNS=2
ANSWER_CONTEXT_MAX_TOTAL_CHARS=6000
ANSWER_CONTEXT_MAX_TURN_CHARS=2000
# One serialized writer owns /ws/transcribe sends. Buffer overflow closes the
# browser lease while logical answer state remains resumable for 30 seconds.
ANSWER_OUTBOUND_BUFFER_ITEMS=128
ANSWER_DELTA_MAX_COALESCED_CHARS=4096

# Reserved provider option; no Deepgram account is required for Milestone 4.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
